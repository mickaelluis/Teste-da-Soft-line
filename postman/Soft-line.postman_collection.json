    },
    {
      "name": "Usuario",
      "item": [
        {
          "name": "Buscar Usuario",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "PHPSESSID={{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/usuario"
          }
        },
        {
          "name": "Atualizar Usuario (nome)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Cookie",
                "value": "PHPSESSID={{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Usuario Atualizado\"\n}"
            },
            "url": "{{baseUrl}}/api/usuario"
          }
        },
        {
          "name": "Atualizar Usuario (senha)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Cookie",
                "value": "PHPSESSID={{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"senha\": \"123456\",\n  \"confirm_senha\": \"123456\"\n}"
            },
            "url": "{{baseUrl}}/api/usuario"
          }
        },
        {
          "name": "Desconectar",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Cookie",
                "value": "PHPSESSID={{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/desconectar",
            "description": "Limpa a sessao e remove o cookie PHPSESSID."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    pm.collectionVariables.set('token', '');",
                  "    console.log('token limpo apos desconectar');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Deletar Usuario",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Cookie",
                "value": "PHPSESSID={{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/usuario",
            "description": "Remove o usuario e encerra a sessao. Clientes/produtos somem por CASCADE."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    pm.collectionVariables.set('token', '');",
                  "    console.log('token limpo apos deletar usuario');",
                  "}"
                ]
              }
            }
          ]
        }
      ]
