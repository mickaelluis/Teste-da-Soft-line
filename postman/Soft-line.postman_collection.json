{
  "info": {
    "name": "Soft-line teste dev",
    "description": "API Soft-line. O login usa sessao PHP: a variavel `token` guarda o PHPSESSID para as rotas protegidas.\n\nOrdem sugerida:\n1. Auth > Login\n2. Clientes / Produtos\n3. Usuario > Buscar / Atualizar / Desconectar / Deletar",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "email",
      "value": "teste@email.com"
    },
    {
      "key": "senha",
      "value": "123456"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "id_cliente",
      "value": "1"
    },
    {
      "key": "id_endereco",
      "value": "1"
    },
    {
      "key": "id_produto",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Usuario Teste\",\n  \"email\": \"{{email}}\",\n  \"senha\": \"{{senha}}\",\n  \"confirm_senha\": \"{{senha}}\"\n}"
            },
            "url": "{{baseUrl}}/api/register"
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const baseUrl = pm.collectionVariables.get('baseUrl');",
                  "    const cookie = pm.cookies.get('PHPSESSID', baseUrl);",
                  "    if (cookie) {",
                  "        pm.collectionVariables.set('token', cookie);",
                  "        console.log('token (PHPSESSID) salvo:', cookie);",
                  "    } else {",
                  "        console.warn('PHPSESSID nao encontrado. Verifique se cookies estao habilitados no Postman.');",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"senha\": \"{{senha}}\"\n}"
            },
            "url": "{{baseUrl}}/api/login"
          }
        }
      ]
    },
    {
      "name": "Clientes",
      "item": [
        {
          "name": "Listar Clientes",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "PHPSESSID={{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/clientes"
          }
        },
        {
          "name": "Buscar Cliente",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "PHPSESSID={{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/cliente?id={{id_cliente}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "cliente"],
              "query": [
                {
                  "key": "id",
                  "value": "{{id_cliente}}"
                }
              ]
            }
          }
        },
        {
          "name": "Inserir Cliente",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Cookie",
                "value": "PHPSESSID={{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"codigo\": 1,\n  \"nome\": \"Cliente Teste\",\n  \"fantasia\": \"Fantasia Teste LTDA\",\n  \"documento\": \"12345678901\",\n  \"cep\": \"01310100\",\n  \"estado\": \"SP\",\n  \"cidade\": \"Sao Paulo\",\n  \"bairro\": \"Bela Vista\",\n  \"rua\": \"Av Paulista\",\n  \"numero\": \"1000\"\n}"
            },
            "url": "{{baseUrl}}/api/clientes"
          }
        },
        {
          "name": "Atualizar Cliente (nome)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Cookie",
                "value": "PHPSESSID={{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": {{id_cliente}},\n  \"nome\": \"Cliente Atualizado\"\n}"
            },
            "url": "{{baseUrl}}/api/clientes"
          }
        },
        {
          "name": "Atualizar Cliente (endereco)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Cookie",
                "value": "PHPSESSID={{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": {{id_cliente}},\n  \"id_endereco\": {{id_endereco}},\n  \"cidade\": \"Campinas\",\n  \"bairro\": \"Centro\"\n}"
            },
            "url": "{{baseUrl}}/api/clientes"
          }
        },
        {
          "name": "Atualizar Cliente (completo)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Cookie",
                "value": "PHPSESSID={{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": {{id_cliente}},\n  \"codigo\": 2,\n  \"nome\": \"Cliente Completo\",\n  \"fantasia\": \"Fantasia Atualizada LTDA\",\n  \"documento\": \"98765432100\",\n  \"id_endereco\": {{id_endereco}},\n  \"cep\": \"13010000\",\n  \"estado\": \"SP\",\n  \"cidade\": \"Campinas\",\n  \"bairro\": \"Centro\",\n  \"rua\": \"Rua Barão de Jaguara\",\n  \"numero\": \"500\"\n}"
            },
            "url": "{{baseUrl}}/api/clientes"
          }
        },
        {
          "name": "Atualizar Cliente (documento duplicado)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Cookie",
                "value": "PHPSESSID={{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": {{id_cliente}},\n  \"documento\": \"12345678901\"\n}"
            },
            "url": "{{baseUrl}}/api/clientes",
            "description": "Esperado: 409 - Esse documento ja esta cadastrado. O banco valida duplicidade via UNIQUE."
          }
        },
        {
          "name": "Deletar Cliente",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Cookie",
                "value": "PHPSESSID={{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/cliente?id={{id_cliente}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "cliente"],
              "query": [
                {
                  "key": "id",
                  "value": "{{id_cliente}}"
                }
              ]
            },
            "description": "DELETE /api/cliente?id={{id_cliente}}. Remove o cliente e o endereco vinculado (ON DELETE CASCADE)."
          }
        },
        {
          "name": "Deletar Cliente (nao encontrado)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Cookie",
                "value": "PHPSESSID={{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/cliente?id=999999",
              "host": ["{{baseUrl}}"],
              "path": ["api", "cliente"],
              "query": [
                {
                  "key": "id",
                  "value": "999999"
                }
              ]
            },
            "description": "Esperado: 404 - Cliente nao encontrado"
          }
        }
      ]
    },
